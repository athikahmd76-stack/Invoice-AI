# ============================================
# InvoiceAI - Local, private, AI invoice extractor
# Copy this file to .env and edit as needed.
# ============================================

APP_NAME=InvoiceAI

# Ollama - local AI runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# AI mode: auto | vision | text
#   auto   - FAST: uses text mode when the PDF has a text layer (no image
#            processing -> much faster on CPU); falls back to vision for scans
#   vision - sends page images to the Ollama vision model (slower, use for scans)
#   text   - sends OCR text only (fastest, any Ollama model)
AI_MODE=auto
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=900
# Lower max tokens = much faster (a typical invoice JSON is 500-1500 tokens).
# Too low truncates long invoices. 2500 covers ~40 line items.
AI_MAX_TOKENS=2500
# Context window sent to Ollama. Keep prompt + images inside this or input gets cut.
AI_NUM_CTX=8192

# Database (SQLite by default - fully local)
DATABASE_URL=sqlite:///data/invoiceai.db

# Upload limits
MAX_FILE_SIZE_MB=25

# OCR
# engine: auto | paddle | text | none
#   auto  - use PaddleOCR if installed, else PDF text layer / vision AI
#   paddle- force PaddleOCR (show error if not installed)
#   text  - PDF text layer only (fast, digital PDFs)
#   none  - no OCR at all (vision AI reads page images directly)
OCR_ENGINE=auto
OCR_LANGUAGE=en
OCR_ENABLE_TABLE=true

# Processing switches
ENABLE_DUPLICATE_CHECK=true
ENABLE_VALIDATION=true
ENABLE_TAX_INTELLIGENCE=true

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO